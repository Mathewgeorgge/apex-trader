# ==============================================================================
# Zerodha Algo Trader Configuration
# Copy this file to .env and fill in your details
# ==============================================================================

# Trading Mode: 'PAPER' for simulated trades with real market ticks, 'LIVE' for actual broker orders
TRADING_MODE=PAPER

# Zerodha Kite Connect Credentials
# Obtain API Key & Secret from https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Optional: Automated Login credentials (for automated daily TOTP token generation)
KITE_USER_ID=your_zerodha_user_id
KITE_PASSWORD=your_zerodha_password
# 32-character TOTP secret key shown as QR code during 2FA setup in Kite
KITE_TOTP_SECRET=your_totp_secret_key_here

# Manual Access Token (if not using automated TOTP login)
KITE_ACCESS_TOKEN=

# Risk Management & Limits (in INR)
MAX_DAILY_LOSS=5000.0
MAX_CAPITAL_PER_TRADE=50000.0
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=3
SLIPPAGE_TOLERANCE_PCT=0.001
AUTO_SQUARE_OFF_TIME=15:15:00

# Default Product Type: MIS (Intraday), CNC (Equity Cash & Carry), NRML (F&O Normal)
DEFAULT_PRODUCT=MIS

# Telegram Notifications (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage & Logging
DATA_DIR=storage
LOG_LEVEL=INFO
